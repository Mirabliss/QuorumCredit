dashboard/node_modules/
server/node_modules/
services/*/node_modules/
tools/*/node_modules/
node_modules/
server/dist/
dashboard/dist/
services/*/dist/
.npm/
.yarn/

# Mutation testing output (cargo-mutants)
mutants.out/

# Runtime backup archives/snapshots (scripts/backup.sh, scripts/test_backup_restore.sh)
