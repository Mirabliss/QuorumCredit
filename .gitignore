indexer.db
indexer.db-*
*.db-journal
*.db-wal
*.db-shm

# Canary deployment decision history (scripts/canary_deploy.sh)
/deploy/

# Node modules / build output for TS services
services/indexer/node_modules/
services/indexer/dist/

# Restore-drill state files (scripts/restore.sh idempotent/resumable scenario 6)
*.state.json
